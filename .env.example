# Legacy Next.js/server development variables.
# The current production site runs on GitHub Pages and does not use these values.
# If the legacy server build is run locally, set the public origin as needed.
SITE_URL=https://5j1u35k6.github.io/77-waxing-site

# Legacy server-side admin login values. The GitHub Pages production admin uses Firebase Authentication instead.
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Legacy Firebase Admin SDK variables for local/server-side Next.js development only.
# The GitHub Pages production build uses Firebase Web SDK + Firestore Security Rules.
# Do NOT expose FIREBASE_PRIVATE_KEY in browser-side code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

APP_ENV=development
