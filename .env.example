# Public production origin used for canonical URLs and future domain changes.
# Example now: https://playful-basbousa-ceda5c.netlify.app
# Later replace only this value with the brand domain, e.g. https://77waxing.com
SITE_URL=

# Single-manager admin login for the current production phase.
# Use long random values in production.
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Firebase Admin SDK (server only). Get these from a Firebase/Google service account.
# Do NOT expose FIREBASE_PRIVATE_KEY in browser-side code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: identify the deployment environment in admin diagnostics.
APP_ENV=development
