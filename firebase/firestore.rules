rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validShopOrderCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'orderNo',
          'ownerUid',
          'customerName',
          'phone',
          'email',
          'deliveryMethod',
          'paymentMethod',
          'storeInfo',
          'shippingFee',
          'items',
          'subtotal',
          'total',
          'status',
          'inventoryCommitted',
          'trackingNumber',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.size() > 0
        && request.resource.data.orderNo.size() <= 50
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.deliveryMethod in ['pickup', '7-11', 'family']
        && request.resource.data.paymentMethod in ['pickup_cash', 'transfer']
        && request.resource.data.storeInfo is string
        && request.resource.data.storeInfo.size() <= 180
        && request.resource.data.shippingFee is number
        && request.resource.data.shippingFee >= 0
        && request.resource.data.shippingFee <= 10000
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 30
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.subtotal <= 10000000
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shippingFee
        && request.resource.data.status == 'pending'
        && request.resource.data.inventoryCommitted == false
        && request.resource.data.trackingNumber == null
        && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 1000))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validShopMessageCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'name',
          'email',
          'content',
          'reply',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 2
        && request.resource.data.content.size() <= 1500
        && request.resource.data.reply == null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function bookingAfter(bookingId) {
      return getAfter(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function lockAfter(lockId) {
      return getAfter(/databases/$(database)/documents/availabilityLocks/$(lockId));
    }

    function validLockAfter(bookingId, lockId) {
      return lockAfter(lockId).data.bookingId == bookingId
        && lockAfter(lockId).data.date == request.resource.data.preferredDate
        && lockAfter(lockId).data.time in request.resource.data.lockTimes
        && lockAfter(lockId).data.state == 'held';
    }

    function validRoundedLockCount(durationMinutes, lockCount) {
      return (durationMinutes > 0 && durationMinutes < 30 && lockCount == 1)
        || (durationMinutes >= 30 && durationMinutes < 60 && lockCount == 2)
        || (durationMinutes >= 60 && durationMinutes < 90 && lockCount == 3)
        || (durationMinutes >= 90 && durationMinutes < 120 && lockCount == 4)
        || (durationMinutes >= 120 && durationMinutes < 150 && lockCount == 5)
        || (durationMinutes >= 150 && durationMinutes < 180 && lockCount == 6)
        || (durationMinutes == 180 && lockCount == 7);
    }

    function validAllBookingLocks(bookingId) {
      let count = request.resource.data.lockIds.size();
      return validLockAfter(bookingId, request.resource.data.lockIds[0])
        && (count < 2 || validLockAfter(bookingId, request.resource.data.lockIds[1]))
        && (count < 3 || validLockAfter(bookingId, request.resource.data.lockIds[2]))
        && (count < 4 || validLockAfter(bookingId, request.resource.data.lockIds[3]))
        && (count < 5 || validLockAfter(bookingId, request.resource.data.lockIds[4]))
        && (count < 6 || validLockAfter(bookingId, request.resource.data.lockIds[5]))
        && (count < 7 || validLockAfter(bookingId, request.resource.data.lockIds[6]));
    }

    function validPublicBookingCreate(bookingId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'customerName',
          'customerPhone',
          'customerPhoneCountry',
          'customerPhoneDialCode',
          'customerPhoneInternational',
          'customerEmail',
          'customerLineId',
          'serviceName',
          'preferredDate',
          'preferredTime',
          'status',
          'isFirstVisit',
          'depositRequired',
          'depositAmount',
          'paymentStatus',
          'durationMinutes',
          'bufferMinutes',
          'lockIds',
          'lockTimes',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.customerPhoneCountry is string
        && request.resource.data.customerPhoneCountry.size() > 0
        && request.resource.data.customerPhoneCountry.size() <= 80
        && request.resource.data.customerPhoneDialCode is string
        && request.resource.data.customerPhoneDialCode.matches('^\\+[0-9]{1,4}$')
        && request.resource.data.customerPhoneInternational is string
        && request.resource.data.customerPhoneInternational.matches('^\\+[0-9]{6,20}$')
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() > 3
        && request.resource.data.customerEmail.size() <= 160
        && request.resource.data.customerEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (request.resource.data.customerLineId == null || (request.resource.data.customerLineId is string && request.resource.data.customerLineId.size() <= 100))
        && request.resource.data.serviceName is string
        && request.resource.data.serviceName.size() > 0
        && request.resource.data.serviceName.size() <= 120
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.preferredTime is string
        && request.resource.data.preferredTime.matches('^\\d{2}:\\d{2}$')
        && request.resource.data.status == 'pending_confirmation'
        && request.resource.data.isFirstVisit is bool
        && request.resource.data.depositRequired == null
        && request.resource.data.depositAmount == null
        && request.resource.data.paymentStatus == 'not_requested'
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes > 0
        && request.resource.data.durationMinutes <= 180
        && request.resource.data.bufferMinutes is int
        && request.resource.data.bufferMinutes >= 0
        && request.resource.data.bufferMinutes <= 30
        && request.resource.data.lockIds is list
        && request.resource.data.lockTimes is list
        && request.resource.data.lockIds.size() == request.resource.data.lockTimes.size()
        && request.resource.data.lockIds.size() >= 1
        && request.resource.data.lockIds.size() <= 7
        && validRoundedLockCount(request.resource.data.durationMinutes, request.resource.data.lockIds.size())
        && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 1000))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validAllBookingLocks(bookingId);
    }

    function validPublicLockCreate(lockId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'date',
          'time',
          'state',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^\\d{2}:\\d{2}$')
        && request.resource.data.state == 'held'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && bookingAfter(request.resource.data.bookingId).data.ownerUid == request.auth.uid
        && bookingAfter(request.resource.data.bookingId).data.preferredDate == request.resource.data.date
        && lockId in bookingAfter(request.resource.data.bookingId).data.lockIds
        && request.resource.data.time in bookingAfter(request.resource.data.bookingId).data.lockTimes;
    }

    match /bookings/{bookingId} {
      allow create: if validPublicBookingCreate(bookingId);
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /availabilityLocks/{lockId} {
      allow read: if signedIn();
      allow create: if validPublicLockCreate(lockId);
      allow update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /customerPhoneIndex/{indexId} {
      allow read, write: if isAdmin();
    }

    match /customerImportBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    match /shopProducts/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /shopOrders/{orderId} {
      allow create: if validShopOrderCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /shopMessages/{messageId} {
      allow create: if validShopMessageCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /shopSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
